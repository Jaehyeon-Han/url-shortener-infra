# backend.hcl.example
#
# 이 파일을 backend.hcl 로 복사한 뒤 bucket 값을 채운다.
#   cp backend.hcl.example backend.hcl
# bucket 값은 bootstrap 스택의 출력값을 사용한다.
#   cd bootstrap && terraform output -raw tfstate_bucket
# 이후 루트 스택 초기화:
#   terraform init -backend-config=backend.hcl
#
# backend.hcl 은 account_id가 포함되므로 .gitignore 처리되어 커밋되지 않는다.

bucket = "urlshortener-tfstate-<ACCOUNT_ID>"